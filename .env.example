PORT=3001
NODE_ENV=production
MOA_STORE_DOMAIN=in.mallofabayas.com

# ---------------------------------------------------------------------------
# Free AI Model Configuration
# ---------------------------------------------------------------------------
# Option 1: Google Gemini (Free Tier API Key from Google AI Studio: https://aistudio.google.com/)
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq (Free Tier API Key from Groq Cloud: https://console.groq.com/)
# GROQ_API_KEY=your_groq_api_key_here

# Option 3: Ollama (100% Free Local AI - e.g. llama3, mistral - No API Key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
